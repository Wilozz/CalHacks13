# SERVER ONLY — copy to .env on the shared signaling server.
# Never put TURN_SHARED_SECRET in a VITE_ variable.
PORT=8787
HOST=127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Public coturn URLs, including TLS/TCP 443 for restrictive Wi-Fi:
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
# TURN_SHARED_SECRET=replace-with-the-same-random-secret-as-coturn
# Managed relay alternative (e.g. Metered): set URLs plus these, and leave TURN_SHARED_SECRET unset.
# TURN_USERNAME=your-provider-issued-turn-username
# TURN_PASSWORD=your-provider-issued-turn-password
# These are TURN client credentials, NOT your dashboard login or API key.
# With TURN configured, relay-only is the default. Set false to prefer direct paths.
# RELAY_ONLY=true

# FRONTEND — if each laptop runs its own Vite app, BOTH use the same public URL.
# Put this in .env.local on both laptops, then restart npm run dev.
# VITE_SIGNALING_URL=wss://ghost.example.com/signal

# Optional: your own TURN relay for restricted event / enterprise Wi-Fi.
# No relay is bundled or provisioned by GHOST.
# Use short-lived credentials: VITE_ variables are visible in browser code.
# VITE_TURN_URL=turns:your-relay.example.com:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# AI server (server/ai.ts). Keep the key server-side; never prefix it with VITE_.
# ANTHROPIC_API_KEY=
# GHOST_PARSE_MODEL=claude-haiku-5-5
# GHOST_SCENE_MODEL=claude-sonnet-5-5
# GHOST_AI_PORT=8790  # not 8787: that is the signaling server's port

# Voice (server/ai.ts mints short-lived browser tokens; the key never reaches the browser).
# Without it, GHOST falls back to the browser's built-in speech recognition.
# CARTESIA_API_KEY=
# GHOST_STT_MODEL=ink-whisper
