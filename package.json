{
  "name": "ghost-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test src/*.test.ts src/ai/*.test.ts src/render/*.test.ts src/remote/*.test.ts",
    "postinstall": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "dev:https": "node scripts/dev-https.mjs",
    "predev:https": "node scripts/prepare-assets.mjs",
    "ai": "node --import tsx server/ai.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "@react-three/fiber": "^9.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
