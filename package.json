{
  "name": "ghost-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test src/*.test.ts src/ai/*.test.ts src/render/*.test.ts src/remote/*.test.ts src/throw/*.test.ts src/voice/*.test.ts server/server.test.mjs",
    "postinstall": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "dev:https": "node scripts/dev-https.mjs",
    "predev:https": "node scripts/prepare-assets.mjs",
    "ai": "node --import tsx server/ai.ts",
    "start": "node server/index.mjs",
    "test:e2e": "playwright test",
    "test:e2e:relay": "node scripts/test-turn.mjs",
    "convex": "convex dev",
    "community:auth": "node scripts/setup-community-auth.mjs",
    "test:community": "vitest run",
    "dev:community": "convex dev --start \"npm run dev\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/presence": "^0.4.0",
    "@fal-ai/client": "^1.10.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "@react-three/fiber": "^9.4.0",
    "convex": "^1.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "convex-test": "^0.0.65",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
